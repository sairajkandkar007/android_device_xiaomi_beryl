# POCO M7 Pro 5G (beryl)
# Android 16 / MT6855
# A/B + Virtual A/B + Dynamic Partitions

# Dynamic partitions
system /system erofs ro,wait,slotselect,avb=vbmeta_system,logical
system_ext /system_ext erofs ro,wait,slotselect,avb=vbmeta_system,logical
product /product erofs ro,wait,slotselect,avb=vbmeta_system,logical

vendor /vendor erofs ro,wait,slotselect,avb,logical
mi_ext /mnt/vendor/mi_ext erofs ro,wait,slotselect,logical

vendor_dlkm /vendor_dlkm erofs ro,wait,slotselect,avb,logical
odm_dlkm /odm_dlkm erofs ro,wait,slotselect,avb,logical
system_dlkm /system_dlkm erofs ro,wait,slotselect,avb,logical

# Metadata
/dev/block/by-name/metadata /metadata ext4 noatime,nosuid,nodev,discard,wait,check,formattable,first_stage_mount

# Userdata / Android FBE v2
/dev/block/by-name/userdata /data f2fs \
    gc_merge,atgc,age_extent_cache,noatime,nosuid,nodev,discard,\
noflush_merge,fsync_mode=nobarrier,reserve_root=134217,\
resgid=1065,inlinecrypt,wait,check,formattable,quota,latemount,\
resize,reservedsize=128m,checkpoint=fs,\
fileencryption=aes-256-xts:aes-256-cts:v2+inlinecrypt_optimized,\
keydirectory=/metadata/vold/metadata_encryption,\
fsverity
