# OrangeFox recovery fstab
# POCO M7 Pro 5G / beryl
# Android 16 / MT6855

system      /system       erofs    ro
system_ext  /system_ext   erofs    ro
product     /product      erofs    ro
vendor      /vendor       erofs    ro
mi_ext      /mi_ext       erofs    ro
vendor_dlkm /vendor_dlkm  erofs    ro
odm_dlkm    /odm_dlkm     erofs    ro
system_dlkm /system_dlkm  erofs    ro

/data       f2fs    rw,discard,inlinecrypt,fileencryption=aes-256-xts:aes-256-cts:v2+wrappedkey_v0,metadata_encryption=aes-256-xts:wrappedkey_v0,quota,checkpoint=fs

/metadata   ext4    rw,discard
